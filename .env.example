# Deadlock City Configuration Example
# Copy to .env and adjust as needed.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Backend capacity & security limits
DEADLOCK_MAX_SESSIONS=100
DEADLOCK_MAX_ENGINE_CONCURRENCY=8
MAX_REQUEST_BODY_BYTES=1048576
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
